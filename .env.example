# Copy to .env (never committed). All values optional; features degrade gracefully when missing.

# --- Server ---
PORT=4100
# Where Software Factory keeps its state (db, config, workflow definitions). Default: ~/.claude/software-factory
# SF_HOME=/Users/you/.claude/software-factory

# --- Jira ---
# Default mode is "mcp": calls go through the claude.ai Atlassian connector you already authorized
# (no token needed). Set JIRA_API_TOKEN (and JIRA_EMAIL) to switch to direct REST calls instead.
JIRA_BASE_URL=https://indysoftco.atlassian.net
JIRA_DEFAULT_PROJECT=IWC
# JQL used by "Sync Jira". Defaults to issues assigned to the authenticated user.
JIRA_SYNC_JQL=assignee in (currentUser(), "joao.mello@indysoft.com") AND statusCategory != Done AND issuetype != Epic ORDER BY updated DESC
# JIRA_MODE=mcp|rest   JIRA_EMAIL=   JIRA_API_TOKEN=   JIRA_CLOUD_ID=indysoftco.atlassian.net
# JIRA_MCP_PREFIX=mcp__claude_ai_Atlassian_MCP__

# --- Fathom ---
# Default mode is "mcp" (claude.ai Fathom connector). Set FATHOM_API_KEY to use the public REST API instead.
# FATHOM_MODE=mcp|rest   FATHOM_API_KEY=   FATHOM_MCP_PREFIX=mcp__claude_ai_FathomMCP__

# --- Azure DevOps (used for Pull Requests; az CLI must be logged in: `az login`) ---
ADO_ORG_URL=
ADO_PROJECT=

# --- Llama (project management). Leave empty to reuse the env of the `llama` MCP server in ~/.claude.json ---
LLAMA_ORG=indysoft
LLAMA_PROJECT=EAM

# --- Second Brain vault (Obsidian / LLM-wiki). Default: ~/Desktop/indysoft/SecondBrain ---
# SF_BRAIN_VAULT=
